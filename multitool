#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
#  Multi Tool — main launcher
#  GitHub · Vercel · Netlify · Supabase · Telegram
# ============================================================

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
MT_HOME="${PREFIX:-/data/data/com.termux/files/usr}/lib/multitool"
[ -d "$MT_HOME" ] || MT_HOME="$SELF_DIR"

# shellcheck disable=SC1090
source "$MT_HOME/lib/common.sh"

main_loop() {
  while true; do
    mt_clear
    mt_banner
    local choice
    choice=$(mt_menu "Select a service:" \
      "GitHub" \
      "Vercel" \
      "Netlify" \
      "Supabase" \
      "Telegram" \
      "Exit") || { mt_clear; mt_info "Bye! 👋"; exit 0; }

    case "$choice" in
      0) mt_load github   ;;
      1) mt_load vercel   ;;
      2) mt_load netlify  ;;
      3) mt_load supabase ;;
      4) mt_load telegram ;;
      5) mt_clear; mt_info "Bye! 👋"; exit 0 ;;
    esac
  done
}

main_loop
